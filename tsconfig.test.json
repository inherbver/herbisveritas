{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react",
    "types": ["@testing-library/jest-dom", "jest", "node"]
  },
  "include": [
    "jest.setup.ts",
    "jest-dom.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/test-utils/**/*.ts",
    "src/test-utils/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
